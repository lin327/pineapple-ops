%% ==================== 样式定义 (颜色搭配) ====================
classDef user fill:#fef08a,stroke:#ca8a04,stroke-width:2px,color:#000;
classDef proxy fill:#bae6fd,stroke:#0284c7,stroke-width:2px,color:#000;
classDef ext fill:#e5e7eb,stroke:#4b5563,stroke-width:2px,color:#000;
classDef core fill:#c7d2fe,stroke:#4f46e5,stroke-width:2px,color:#000;
classDef app fill:#bbf7d0,stroke:#16a34a,stroke-width:2px,color:#000;
classDef db fill:#fed7aa,stroke:#ea580c,stroke-width:2px,color:#000;
classDef monitor fill:#e9d5ff,stroke:#9333ea,stroke-width:2px,color:#000;
classDef log fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#000;

%% 批量应用样式到节点
class User,EMAIL user;
class CF,NG proxy;
class RESEND,GITHUB,CLOUD ext;
class MASTER,W1,W2 core;
class GHOST,KUBOARD,ALIST,VW,BASTION app;
class MINIO,MDB,REDIS db;
class GRAFANA,VM,NE,NE2,UK monitor;
class ES,FB,KB log;

