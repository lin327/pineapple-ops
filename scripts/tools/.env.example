# Grafana 日报脚本环境变量配置
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# 使用方式: source .env && python3 grafana-report.py

# === 必填 ===
GRAFANA_PASS=your_grafana_password
RESEND_API_KEY=re_your_resend_api_key

# === 可选 (有默认值) ===
# GRAFANA_URL=http://localhost:30858
# GRAFANA_USER=admin
# VM_URL=http://localhost:32728
# FROM_EMAIL=report@tentative.me
# TO_EMAIL=your_email@example.com
# DASHBOARD_UID=pineapple-ops
